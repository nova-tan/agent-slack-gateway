# Required — from the Slack app you create (see slack-app-manifest.example.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional workspace URL for conversation context
SLACK_WORKSPACE_URL=

# Only these Slack user IDs may talk to the gateway (comma-separated).
# Empty denies all users. Replace this placeholder with your own Slack user ID.
ALLOWED_USERS=U0123456789

# Choose the CLI backend: copilot (default) or codex
GATEWAY_PROVIDER=copilot

# Codex CLI (authenticate with `codex login` before starting)
CODEX_BIN=codex
CODEX_MODEL=

# Copilot CLI
COPILOT_BIN=copilot
# Optional model ID supported by your Copilot CLI.
COPILOT_MODEL=

# MCP servers passed to every ACP session. Defaults to ~/.copilot/mcp-config.json.
# COPILOT_MCP_CONFIG=~/.copilot/mcp-config.json

# Working directory Copilot sessions run in (fs access is confined here)
GATEWAY_CWD=~

# "buttons" = approve/deny requests in Slack; "auto" = bypass approvals and sandbox
APPROVAL_MODE=buttons

# Sessions older than this are recycled on next message ("daily rollover")
MAX_SESSION_AGE_HOURS=18

# Optional tuning
# SHOW_THOUGHTS=false
# PERMISSION_TIMEOUT_SECONDS=300
# PROMPT_TIMEOUT_SECONDS=3600
# Recent Slack messages injected as recovery context when a session restarts (0 disables)
# CONTEXT_HISTORY_MESSAGES=30
# GATEWAY_STATE_DIR=~/.copilot-slack-gateway
# COPILOT_RELAX_X509_STRICT=false
